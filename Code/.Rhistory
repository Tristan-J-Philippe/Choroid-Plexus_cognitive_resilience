scale(mat1)
View(mat1)
mat1 <- data.frame(ex_vivo_ChP_metadata_demographics$cogdx, ex_vivo_ChP_metadata_demographics$ad_adnc, ex_vivo_ChP_metadata_demographics$age_death, ex_vivo_ChP_metadata_demographics$educ)
Heatmap(scale(mat1), cluster_rows = F, cluster_columns = F, show_heatmap_legend = F, turbo(100))
m1 <- matrix(ex_vivo_ChP_metadata_demographics$Cog_Path)
colnames(m1) <- "Cog_Path"
m2 <- matrix(ex_vivo_ChP_metadata_demographics$cogdx)
colnames(m2) <- "cogdx"
m3 <- matrix(ex_vivo_ChP_metadata_demographics$ad_adnc)
colnames(m3) <- "ad_adnc"
m5 <- matrix(ex_vivo_ChP_metadata_demographics$age_death)
colnames(m5) <- "age_death"
m6 <- matrix(ex_vivo_ChP_metadata_demographics$educ)
colnames(m6) <- "educ"
m7 <- matrix(ex_vivo_ChP_metadata_demographics$msex)
colnames(m7) <- "sex"
#select colors
ht1 <- Heatmap(m1, cluster_rows = F, cluster_columns = F, show_heatmap_legend = T,
setNames(c("skyblue3", "tomato3", "darkred"), c("NCI","resilient","ADd")))
ht2 <- Heatmap(m2, cluster_rows = F, cluster_columns = F, show_heatmap_legend = T,
colorRamp2(c(1,2,4), col=c("skyblue","tomato", "red3")))
ht3 <- Heatmap(m3, cluster_rows = F, cluster_columns = F, show_heatmap_legend = T,
colorRamp2(c(0,1), col=c("gold","goldenrod4")))
ht5 <- Heatmap(m5, cluster_rows = F, cluster_columns = F, show_heatmap_legend = T,
colorRamp2(c(85,100), col=c("dodgerblue", "royalblue4")))
ht6 <- Heatmap(m6, cluster_rows = F, cluster_columns = F, show_heatmap_legend = T,
colorRamp2(c(15,20), col=c("seagreen1", "darkseagreen4")))
ht7 <- Heatmap(m7, cluster_rows = F, cluster_columns = F, show_heatmap_legend = T,
colorRamp2(c(1,0), col=c("blue", "purple")))
draw(ht1+ht2+ht3+ht5+ht6+ht7)
pdf("~/Metaheat ChP1.pdf", width=7, height=7)
draw(ht1+ht2+ht3+ht5+ht6+ht7)
dev.off()
